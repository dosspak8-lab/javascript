const numbers = [4, 9, 16, 25, 29];
console.log(numbers.indexOf(16));           // 2
console.log(numbers.includes(9));           // true
console.log(numbers.find(x => x > 18));     // 25
console.log(numbers.findIndex(x => x > 18)); // 3

//indexOf()Cari posisi pertama
// lastIndexOf()Cari posisi terakhir
// includes()Cek ada atau tidak (true/false)
// find()Cari elemen yang memenuhi kondisi
// findIndex()Cari index yang memenuhi kondisi
// findLast()Sama seperti find, tapi dari belakang
// findLastIndex()Sama seperti findIndex, dari belakang
