const numbers = [1, 2, 3, 4, 5];

// map
const doubled = numbers.map(n => n * 2);          // [2, 4, 6, 8, 10]

// filter
const even = numbers.filter(n => n % 2 === 0);    // [2, 4]

// reduce
const sum = numbers.reduce((total, n) => total + n, 0); // 15

// forEach
numbers.forEach(n => console.log(n));



//forEach()Jalankan fungsi untuk setiap elemen
// map()Buat array baru hasil transformasi
// filter()Buat array baru yang lolos kondisi
// reduce()Ubah jadi 1 nilai (misalnya jumlah)
// every()Cek apakah semua elemen memenuhi kondisi
// some()Cek apakah ada elemen yang memenuhi kondisi
